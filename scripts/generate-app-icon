#!/bin/zsh
set -euo pipefail

repo_root="${0:A:h:h}"
source_svg="$repo_root/Branding/devnotch-app-icon.svg"
icon_dir="$repo_root/boringNotch/Assets.xcassets/AppIcon.appiconset"
render_dir="$(mktemp -d)"
trap 'rm -rf "$render_dir"' EXIT

if [[ ! -f "$source_svg" ]]; then
  print -u2 "Missing icon source: $source_svg"
  exit 1
fi

qlmanage -t -s 1024 -o "$render_dir" "$source_svg" >/dev/null 2>&1
rendered="$render_dir/devnotch-app-icon.svg.png"
if [[ ! -f "$rendered" ]]; then
  print -u2 "Quick Look failed to render $source_svg"
  exit 1
fi

typeset -A outputs=(
  [devnotch-16.png]=16
  [devnotch-16@2x.png]=32
  [devnotch-32.png]=32
  [devnotch-32@2x.png]=64
  [devnotch-128.png]=128
  [devnotch-128@2x.png]=256
  [devnotch-256.png]=256
  [devnotch-256@2x.png]=512
  [devnotch-512.png]=512
  [devnotch-512@2x.png]=1024
)

for filename size in ${(kv)outputs}; do
  sips --resampleHeightWidth "$size" "$size" "$rendered" --out "$icon_dir/$filename" >/dev/null
done

print "Generated DevNotch app icons in $icon_dir"
