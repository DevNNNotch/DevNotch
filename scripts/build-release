#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

if [[ $# -ne 2 ]]; then
  die "Usage: $0 <version> <build-number>"
fi

VERSION="$1"
BUILD_NUMBER="$2"
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || die "Version must be a semantic version without a leading v: $VERSION"
[[ "$BUILD_NUMBER" =~ ^[1-9][0-9]*$ ]] || die "Build number must be a positive integer: $BUILD_NUMBER"

[[ -n "${DEVNOTCH_DEVELOPMENT_TEAM:-}" ]] || die "Set DEVNOTCH_DEVELOPMENT_TEAM to the Apple Developer Team ID"
DEVELOPMENT_TEAM="$DEVNOTCH_DEVELOPMENT_TEAM"
SIGNING_IDENTITY="${DEVNOTCH_SIGNING_IDENTITY:-Developer ID Application}"
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
SELECTED_DEVELOPER_DIRECTORY="$(xcode-select -p 2>/dev/null || true)"
[[ "$SELECTED_DEVELOPER_DIRECTORY" == *Xcode.app/Contents/Developer ]] || die "Full Xcode 16.4 or newer is required. Select it with xcode-select before releasing."
security find-identity -v -p codesigning | grep -F "$SIGNING_IDENTITY" >/dev/null || die "Signing identity not found in the active keychain: $SIGNING_IDENTITY"

DIST_DIRECTORY="$PROJECT_ROOT/dist"
ARCHIVE_PATH="$DIST_DIRECTORY/DevNotch.xcarchive"
APP_PATH="$DIST_DIRECTORY/DevNotch.app"
DMG_PATH="$DIST_DIRECTORY/DevNotch-$VERSION.dmg"

[[ ! -e "$ARCHIVE_PATH" && ! -e "$APP_PATH" && ! -e "$DMG_PATH" ]] || die "Release output already exists in $DIST_DIRECTORY. Move or remove it explicitly before retrying."
mkdir -p "$DIST_DIRECTORY"

xcodebuild clean archive \
  -project "$PROJECT_ROOT/boringNotch.xcodeproj" \
  -scheme boringNotch \
  -configuration Release \
  -archivePath "$ARCHIVE_PATH" \
  -destination "generic/platform=macOS" \
  MARKETING_VERSION="$VERSION" \
  CURRENT_PROJECT_VERSION="$BUILD_NUMBER" \
  DEVELOPMENT_TEAM="$DEVELOPMENT_TEAM" \
  CODE_SIGN_STYLE=Manual \
  CODE_SIGN_IDENTITY="$SIGNING_IDENTITY" \
  OTHER_CODE_SIGN_FLAGS="--timestamp" \
  archive

ARCHIVED_APP="$ARCHIVE_PATH/Products/Applications/DevNotch.app"
[[ -d "$ARCHIVED_APP" ]] || die "Archive does not contain the expected application: $ARCHIVED_APP"
ditto "$ARCHIVED_APP" "$APP_PATH"

INFO_PLIST="$APP_PATH/Contents/Info.plist"
[[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$INFO_PLIST")" == "dev.devnotch.app" ]] || die "Release bundle identifier is not dev.devnotch.app"
[[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$INFO_PLIST")" == "$VERSION" ]] || die "Release bundle version does not match $VERSION"
codesign --verify --deep --strict --verbose=2 "$APP_PATH"
SIGNATURE_DETAILS="$(codesign --display --verbose=4 "$APP_PATH" 2>&1)"
grep -F "Authority=$SIGNING_IDENTITY" <<< "$SIGNATURE_DETAILS" >/dev/null || die "App was not signed by the requested Developer ID identity"
grep -E '^Timestamp=' <<< "$SIGNATURE_DETAILS" >/dev/null || die "App signature does not contain a trusted timestamp"
grep -E '^CodeDirectory .*flags=.*runtime' <<< "$SIGNATURE_DETAILS" >/dev/null || die "App signature does not enable the hardened runtime"

"$PROJECT_ROOT/Configuration/dmg/create_dmg.sh" "$APP_PATH" "$DMG_PATH" "DevNotch $VERSION"
codesign --force --timestamp --sign "$SIGNING_IDENTITY" "$DMG_PATH"
codesign --verify --verbose=2 "$DMG_PATH"

printf 'Built signed release: %s\n' "$DMG_PATH"
printf 'Next: scripts/notarize-release %s\n' "$DMG_PATH"
