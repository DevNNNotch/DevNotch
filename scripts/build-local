#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source "$PROJECT_ROOT/scripts/lib/macos-toolchain"

usage() {
  cat <<'USAGE'
Usage: scripts/build-local [--configuration Debug|Release] [--install]

Builds an ad-hoc signed DevNotch.app from source. --install copies the verified
app to /Applications and refuses to overwrite an existing installation.
USAGE
}

CONFIGURATION="Release"
INSTALL=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --configuration)
      [[ $# -ge 2 ]] || devnotch_die "--configuration requires Debug or Release"
      CONFIGURATION="$2"
      shift 2
      ;;
    --install)
      INSTALL=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      devnotch_die "Unknown argument: $1"
      ;;
  esac
done

[[ "$CONFIGURATION" == "Debug" || "$CONFIGURATION" == "Release" ]] || devnotch_die "Configuration must be Debug or Release"
devnotch_require_macos 14
devnotch_require_xcode 16 4

DERIVED_DATA="$PROJECT_ROOT/.build/xcode"
xcodebuild \
  -project "$PROJECT_ROOT/boringNotch.xcodeproj" \
  -scheme boringNotch \
  -configuration "$CONFIGURATION" \
  -derivedDataPath "$DERIVED_DATA" \
  -destination "generic/platform=macOS" \
  CODE_SIGN_STYLE=Manual \
  CODE_SIGN_IDENTITY=- \
  DEVELOPMENT_TEAM= \
  ENABLE_HARDENED_RUNTIME=NO \
  build

APP_PATH="$DERIVED_DATA/Build/Products/$CONFIGURATION/DevNotch.app"
[[ -d "$APP_PATH" ]] || devnotch_die "Build succeeded but the expected app was not found: $APP_PATH"
[[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APP_PATH/Contents/Info.plist")" == "dev.devnotch.app" ]] || devnotch_die "Built app has an unexpected bundle identifier"
codesign --verify --deep --strict "$APP_PATH" || devnotch_die "Ad-hoc signature verification failed: $APP_PATH"

if [[ "$INSTALL" == true ]]; then
  INSTALL_PATH="/Applications/DevNotch.app"
  [[ ! -e "$INSTALL_PATH" ]] || devnotch_die "Refusing to overwrite $INSTALL_PATH. Remove the existing app explicitly, then rerun this command."
  ditto "$APP_PATH" "$INSTALL_PATH"
  codesign --verify --deep --strict "$INSTALL_PATH" || devnotch_die "Installed app signature verification failed: $INSTALL_PATH"
  printf 'Installed %s\n' "$INSTALL_PATH"
else
  printf 'Built %s\n' "$APP_PATH"
fi
