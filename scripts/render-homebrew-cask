#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

if [[ $# -ne 4 ]]; then
  die "Usage: $0 <version> <sha256> <owner/repository> <output-path>"
fi

VERSION="$1"
SHA256="$2"
REPOSITORY="$3"
OUTPUT_PATH="$4"
[[ "$SHA256" =~ ^[0-9a-f]{64}$ ]] || die "SHA-256 must be exactly 64 lowercase hexadecimal characters"
[[ "$REPOSITORY" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "Repository must have owner/name form: $REPOSITORY"

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
"$PROJECT_ROOT/scripts/validate-version" --stable "$VERSION" >/dev/null
TEMPLATE="$PROJECT_ROOT/Packaging/Homebrew/Casks/devnotch.rb.template"
[[ -f "$TEMPLATE" ]] || die "Cask template not found: $TEMPLATE"
mkdir -p "$(dirname "$OUTPUT_PATH")"

sed \
  -e "s/__VERSION__/$VERSION/g" \
  -e "s/__SHA256__/$SHA256/g" \
  -e "s#__REPOSITORY__#$REPOSITORY#g" \
  "$TEMPLATE" > "$OUTPUT_PATH"

grep -F '__VERSION__' "$OUTPUT_PATH" >/dev/null && die "Unresolved version placeholder in $OUTPUT_PATH"
grep -F '__SHA256__' "$OUTPUT_PATH" >/dev/null && die "Unresolved checksum placeholder in $OUTPUT_PATH"
grep -F '__REPOSITORY__' "$OUTPUT_PATH" >/dev/null && die "Unresolved repository placeholder in $OUTPUT_PATH"
printf 'Rendered %s\n' "$OUTPUT_PATH"
